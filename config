ngx_addon_name=ngx_http_dynamic_upstream_module

# Resolve a relative --add-module path to a full one so the build does not
# depend on the directory configure was run from (upstream #5).
ngx_addon_dir=$(cd "$ngx_addon_dir" && pwd)

dynamic_upstream_srcs="                                     \
    $ngx_addon_dir/src/ngx_http_dynamic_upstream_module.cpp \
    $ngx_addon_dir/src/ngx_dynamic_upstream_op.cpp          \
"

dynamic_upstream_deps="                              \
    $ngx_addon_dir/src/ngx_dynamic_upstream_module.h \
    $ngx_addon_dir/src/ngx_dynamic_upstream_op.h     \
"

# The http module is always built.  The stream module joins it only when
# nginx itself has the stream subsystem, so the module builds against an
# http-only nginx too.
dynamic_upstream_mods=ngx_http_dynamic_upstream_module
if [ "$STREAM" = YES ]; then
    dynamic_upstream_mods="ngx_http_dynamic_upstream_module ngx_stream_dynamic_upstream_module"
fi

# The sources are C++ and nginx links with the C compiler driver, so the C++
# runtime has to be named.  It is libstdc++ with gcc and on glibc systems,
# and libc++ on the BSDs and macOS, where there is no libstdc++ in the base.
dynamic_upstream_cxxlib=-lstdc++
case "$NGX_SYSTEM" in
    FreeBSD | OpenBSD | NetBSD | DragonFly | Darwin)
        dynamic_upstream_cxxlib=-lc++
        ;;
esac

CORE_INCS="$CORE_INCS $ngx_addon_dir/src"

if test -n "$ngx_module_link"; then

    ngx_module_type=HTTP
    ngx_module_name="$dynamic_upstream_mods"
    ngx_module_incs=
    ngx_module_deps="$dynamic_upstream_deps"
    ngx_module_srcs="$dynamic_upstream_srcs"
    ngx_module_libs="$dynamic_upstream_cxxlib -lpthread"

    . auto/module

else

    HTTP_MODULES="$HTTP_MODULES ngx_http_dynamic_upstream_module"
    if [ "$STREAM" = YES ]; then
        STREAM_MODULES="$STREAM_MODULES ngx_stream_dynamic_upstream_module"
    fi
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $dynamic_upstream_srcs"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $dynamic_upstream_deps"
    CORE_LIBS="$CORE_LIBS $dynamic_upstream_cxxlib -lpthread"

fi
